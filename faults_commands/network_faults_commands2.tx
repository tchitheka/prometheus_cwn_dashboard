WAN / Internet — "Network Health Check" panel (Internet issue side)

# Packet loss (drives node_qoe_packet_loss_ratio > 1%)
sudo ./wan_packet_loss_test.sh 15 5              # 15% loss, 5 min, default interface
sudo ./wan_packet_loss_test.sh --clear           # manual escape hatch

# Latency (drives node_qoe_rtt_p90_ms; panel bands: <100ms green, 100-200ms orange, >200ms red)
sudo ./qoe_delay_test.sh 350 5 50 enx00e04c423410 (both packet loss and qoe)
sudo ./qoe_delay_test.sh 200 5                   # push into orange
sudo ./qoe_delay_test.sh 350 5                   # push into red
sudo ./qoe_delay_test.sh 200 5 50                # with ±50ms jitter
sudo ./qoe_delay_test.sh --clear                 # manual escape hatch



Wi-Fi / Local — "Network Health Check" panel (Wi-Fi issue side)
# Drop ratio on AP1's phy0-ap0 (drives node_wifi_qdisc_dropped_packets_total > 1%)
./wifi_drop_test.sh 15 5 root@192.168.1.100      # 15% loss, 5 min
./wifi_drop_test.sh --clear root@192.168.1.100   # manual escape hatch


Both at once — triggers verdict 3, "Multiple issues"
sudo ./wan_packet_loss_test.sh 15 5 &
./wifi_drop_test.sh 15 5 root@192.168.1.100 &


DNS — "Name Resolution (DNS Health)" panel (bands: <1% green, 1-5% orange, >5% red)
./dns_fault_test.sh 5                            # local, default .invalid domain
./dns_fault_test.sh 5 takondwa@192.168.1.11      # from a station (needed — see note below)
./dns_fault_test.sh 5 takondwa@192.168.1.11 broken.example   # custom domain


Memory — "Memory pressure" panel (bands: >20% available green, 10-20% orange, <10% red)
./memfill_test.sh 15 10 192.168.1.100            # drive to 15% available (orange), hold 10 min
./memfill_test.sh 8 10 192.168.1.100             # drive to 8% available (red, safety floor)


CPU — "AP Resource Health" panel (bands: <70% green, 70-90% orange, >90% red
./cpufill_test.sh 80 10 192.168.1.100            # ~80% avg load (orange), hold 10 min
./cpufill_test.sh 95 5 192.168.1.100             # continuous max-load (red), hold 5 min


Link stability — "Link flap events" panel (node_network_carrier_changes_total)
./flap_test.sh                    # defaults: 12 cycles, 2s down / 5s up (~84s total)
./flap_test.sh 5 3 20              # 5 cycles, 3s down, 20s up — fewer, longer flaps
./flap_test.sh 20 1 3              # 20 cycles, rapid 1s down / 3s up — flappier/noisier link


 EXAMPLES:
   ./flap_test.sh                                    # AP1, defaults: 12 cycles, 2s down, 5s up
   ./flap_test.sh 5 3 20                              # AP1, 5 cycles, 3s down, 20s up
   ./flap_test.sh 12 2 5 root@192.168.1.101           # AP2, same cycle pattern as the default
   ./flap_test.sh 5 3 20 root@192.168.1.101           # AP2, 5 cycles, 3s down, 20s up


other

./throughputtest.bash 50 200 takondwa@192.168.1.11   # 50MB up, 200MB down




